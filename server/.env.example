MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brainstrain
ADMIN_PASSWORD=change-me
PORT=5000

# Resend (https://resend.com) — used to send registration/approval/reminder emails.
# FROM_EMAIL must be on a domain verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# Shown in the "day-before" reminder email.
EVENT_VENUE=Main Auditorium, GCT
EVENT_REPORTING_TIME=9:00 AM
